    {"$GMRAssetLayer":"","%Name":"Assets_1","assets":[
        {"$GMRSpriteGraphic":"v1","%Name":"graphic_614499A7_2","animationSpeed":1.0,"colour":4294967295,"frozen":false,"headPosition":0.0,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"name":"graphic_614499A7_2","resourceType":"GMRSpriteGraphic","resourceVersion":"2.0","rotation":0.0,"scaleX":9.216216,"scaleY":6.12,"spriteId":{"name":"spr_background","path":"sprites/spr_background/spr_background.yy",},"x":0.0,"y":768.0,},
        {"$GMRTextItem":"v3","%Name":"text_5E29500B","alignment":0,"charSpacing":0.0,"colour":4294967295,"fontId":{"name":"fnt_main","path":"fonts/fnt_main/fnt_main.yy",},"frameH":0.0,"frameW":0.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":0.0,"name":"text_5E29500B","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":1.3243244,"scaleY":1.0,"text":"INSTRUCTIONS :","wrap":false,"x":480.0,"y":0.0,},
        {"$GMRTextItem":"v3","%Name":"text_71D50CBD","alignment":0,"charSpacing":0.0,"colour":4294967295,"fontId":{"name":"fnt_main_small","path":"fonts/fnt_main_small/fnt_main_small.yy",},"frameH":0.0,"frameW":0.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":0.0,"name":"text_71D50CBD","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":0.9673136,"scaleY":1.0,"text":"If you don't know how Guess Who works, you will need 2 people\r\nin order to play. Ask a friend (or enemy) to get the game on\r\nthier device, and play thorugh a discord call or somthing.\r\nEach player needs thier own game on thier own screen.\r\n\r\nOnce you're set, take turns asking \"yes\" or \"no\" questions to\r\ntry and figure out who your opponent's character is! Whoever\r\nguesses correct first wins.","wrap":false,"x":97.0,"y":67.5,},
        {"$GMRTextItem":"v3","%Name":"text_3F49783C","alignment":1,"charSpacing":0.0,"colour":4294967295,"fontId":{"name":"fnt_main_small","path":"fonts/fnt_main_small/fnt_main_small.yy",},"frameH":0.0,"frameW":0.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":0.0,"name":"text_3F49783C","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":1.0,"scaleY":1.0,"text":"Here are some rules to spice up the game!\r\n(You can adjust to your liking)","wrap":false,"x":97.0,"y":409.62567,},
        {"$GMRTextItem":"v3","%Name":"text_34038101","alignment":0,"charSpacing":0.0,"colour":4294967295,"fontId":{"name":"fnt_main_small","path":"fonts/fnt_main_small/fnt_main_small.yy",},"frameH":0.0,"frameW":0.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":0.0,"name":"text_34038101","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":1.0,"scaleY":1.0,"text":"1. No repeated questions!\r\n2. No questions about card's placement  on the board!\r\n3. Each player gets 3 guesses. If they run out guesses,\r\nthey lose! Guessing also takes a turn.","wrap":false,"x":97.0,"y":491.62567,},
        {"$GMRTextItem":"v3","%Name":"text_1962C1A5","alignment":0,"charSpacing":0.0,"colour":4278255615,"fontId":{"name":"fnt_main_small","path":"fonts/fnt_main_small/fnt_main_small.yy",},"frameH":0.0,"frameW":0.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":0.0,"name":"text_1962C1A5","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":1.0,"scaleY":1.0,"text":"4. As a Optional house rule, the loser gets one final guess\r\nand if correct then it's a tie!","wrap":false,"x":97.0,"y":658.5,},
        {"$GMRSpriteGraphic":"v1","%Name":"graphic_7D97FC0C","animationSpeed":1.0,"colour":4294967295,"frozen":false,"headPosition":0.0,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"name":"graphic_7D97FC0C","resourceType":"GMRSpriteGraphic","resourceVersion":"2.0","rotation":-0.039564684,"scaleX":23.75,"scaleY":13.6875,"spriteId":{"name":"spr_info_box","path":"sprites/spr_info_box/spr_info_box.yy",},"x":1174.0,"y":463.99448,},
        {"$GMRTextItem":"v3","%Name":"text_38C46373","alignment":0,"charSpacing":0.0,"colour":4294967295,"fontId":{"name":"fnt_main_small","path":"fonts/fnt_main_small/fnt_main_small.yy",},"frameH":0.0,"frameW":0.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":0.0,"name":"text_38C46373","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":1.0,"scaleY":1.0,"text":"[+] Increase Volume\r\n[-] Decrease Volume\r\n[F5] Restart the game\r\n[F4] Toggle Fullscreen","wrap":false,"x":991.0,"y":395.0,},
        {"$GMRTextItem":"v3","%Name":"text_4014D0F5","alignment":0,"charSpacing":0.0,"colour":4278255615,"fontId":{"name":"fnt_main_small","path":"fonts/fnt_main_small/fnt_main_small.yy",},"frameH":0.0,"frameW":0.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":0.0,"name":"text_4014D0F5","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":1.0,"scaleY":1.0,"text":"Extra Controlls","wrap":false,"x":1044.0,"y":354.5,},
